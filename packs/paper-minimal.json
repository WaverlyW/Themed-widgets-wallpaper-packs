{
  "id": "paper-minimal",
  "name": "Paper Minimal",
  "author": "Waverly",
  "description": "Quiet off-white paper with a dotted grid and ink accents.",
  "tags": ["light", "minimal", "monochrome"],
  "palette": {
    "background": ["#f5f1e8", "#e7e0d0"],
    "surface": "#fffdf8",
    "text": "#1c1917",
    "accent": "#dc2626",
    "muted": "#78716c"
  },
  "font": { "display": "Playfair Display", "body": "Inter" },
