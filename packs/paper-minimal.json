    "opacity": 0.95,
    "include": ["quote", "clock", "calendar", "countdown"],
    "quote": { "text": "Simplicity is the ultimate sophistication.", "author": "Leonardo da Vinci" },
    "weather": { "city": "Copenhagen", "temp": 11, "condition": "cloudy", "unit": "C" },
    "countdown": { "label": "Deadline", "date": "2026-11-01" }
